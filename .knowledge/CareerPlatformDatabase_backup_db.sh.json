{"is_source_file": true, "format": "bash", "description": "A shell script for detecting and backing up various types of databases (SQLite, PostgreSQL, MySQL, MongoDB). It includes checks for database presence and execution of appropriate dump commands, with different fallback mechanisms for MySQL authentication.", "external_files": ["/usr/lib/postgresql/", "/var/run/mysqld/mysqld.sock"], "external_methods": ["ls", "sudo", "mysqladmin ping", "mysql", "mysqldump", "mongosh", "mongodump"], "published": [], "classes": [], "methods": [], "calls": ["ls /usr/lib/postgresql/", "sudo -u postgres ${PG_BIN}/pg_isready", "mysqladmin ping -h localhost -P ${DB_PORT} --silent", "sudo mysqladmin ping --socket=/var/run/mysqld/mysqld.sock --silent", "mysql -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} -e \"SELECT 1\"", "mysqldump -h localhost -P ${DB_PORT} -u ${DB_USER} -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "sudo mysqldump --socket=/var/run/mysqld/mysqld.sock -u root -p${DB_PASSWORD} --databases ${DB_NAME} --add-drop-database --routines --triggers --single-transaction", "mongosh --port ${DB_PORT} --eval \"db.adminCommand('ping')\"", "mongodump --port ${DB_PORT} --db ${DB_NAME} --archive=database_backup.archive --quiet"], "search-terms": ["backup_db.sh", "database backup", "SQLite", "PostgreSQL", "MySQL", "MongoDB", "database detection", "shell script", "database dump", "backup mechanisms"], "state": 2, "file_id": 1, "knowledge_revision": 12, "git_revision": "4b2bc323dad5eb57f1bf9524be37855bc50c4cf1", "hash": "7af9aa35fa4940f934d83f6e2621b732", "format-version": 4, "code-base-name": "CareerPlatformDatabase", "filename": "CareerPlatformDatabase/backup_db.sh", "revision_history": [{"12": "4b2bc323dad5eb57f1bf9524be37855bc50c4cf1"}]}